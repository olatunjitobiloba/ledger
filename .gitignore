# Secrets. Never commit these.
.env
.env.*
!.env.example
*.pem
*.crt
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Eval output. Results belong in PostgreSQL, not in git.
# Use `python -m ledger evidence export` to
# produce a portable evidence bundle instead of committing raw results.
results/
*.jsonl
eval_results/

# Local blob storage for captured payloads. Never commit user data.
data/blobs/

# Local databases (development only; production uses Rumpty managed Postgres).
*.db
*.sqlite
*.sqlite3

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local tooling / skills
.kilo/
.superpowers/
.agents/

