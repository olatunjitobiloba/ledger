# Base URL of the Ledger API the dashboard calls from the browser,
# without a trailing slash. Example: https://ledger.example.com
NEXT_PUBLIC_BACKEND_URL=

# The same LEDGER_ADMIN_TOKEN your Ledger API runs with, sent when creating
# projects. It's inlined into the client bundle at build time, so anyone who
# loads the dashboard can read it. Leave empty only if the API has none.
NEXT_PUBLIC_LEDGER_ADMIN_TOKEN=
