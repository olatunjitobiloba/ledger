# Base URL of the Ledger API the dashboard calls from the browser,
# without a trailing slash. Example: https://ledger.example.com
NEXT_PUBLIC_BACKEND_URL=

# Server-only. The same LEDGER_ADMIN_TOKEN your Ledger API runs with. The
# dashboard's /api/projects route uses it to create projects, so visitors never
# see it and never have to enter it. Leave empty only if the API has none.
LEDGER_ADMIN_TOKEN=
