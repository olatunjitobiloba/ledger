# Copy to .env and fill in. .env is gitignored, so a real key here cannot be committed.
# Never paste a key into chat, issues, or commits. Rotate any key that has been pasted.
#
# OpenRouter (recommended, since that is the account you have):
#   OPENROUTER_API_KEY=sk-or-v1-...
#
# OpenAI, if you ever use it:
#   OPENAI_API_KEY=sk-...

OPENROUTER_API_KEY=