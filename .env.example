# Copy this file to .env. .env and certificates are intentionally gitignored.
# Do not paste real keys, passwords, or certificates into Git, chat, or issues.

# --- Judge (choose one provider) ---
# OpenAI, OpenRouter, and Groq all speak the same API. Set exactly one key.
# Groq is the default provider for this deployment.
# GROQ_API_KEY=gsk_...
# Alternative providers:
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# Optional model override. Defaults: openai/gpt-oss-120b (Groq),
# gpt-4o-mini (OpenAI/OpenRouter).
# LEDGER_JUDGE_MODEL=

# --- Rumpty managed PostgreSQL ---
# Paste Rumpty's INTERNAL connection string here for an API/worker deployed on
# Rumpty. The app accepts postgres://, postgresql://, or postgresql+psycopg://.
# For a local machine, use Rumpty's external connection string instead.
LEDGER_DATABASE_URL=postgresql+psycopg://USERNAME:PERCENT_ENCODED_PASSWORD@INTERNAL_HOST:PORT/DATABASE_NAME

# Save Rumpty's server/CA certificate exactly as received at the path below.
# Do not paste the multi-line certificate into this .env file.
LEDGER_DB_SSLMODE=verify-full
LEDGER_DB_SSLROOTCERT=./certs/ledger-db-ca.crt
# Leave false on Rumpty: apply migrations/001_ledger_schema.sql first.
LEDGER_AUTO_CREATE_SCHEMA=false

# --- Ledger service ---
LEDGER_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
LEDGER_BLOB_DIR=./data/blobs
LEDGER_WORKER_POLL_SECONDS=0.5

# Optional pricing override, USD per token. Keep it as one line of JSON.
# LEDGER_MODEL_PRICING={"gpt-4o-mini":{"input":0.00000015,"output":0.0000006}}
